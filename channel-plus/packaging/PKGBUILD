# Maintainer: tylor <tylorismusic@users.noreply.github.com>
pkgname=suite-channel
pkgver=0.2.5
pkgrel=1
pkgdesc="Vertical SSL-style channel strip with VCA/76Blue compression and 4K EQ (CLAP + LV2)"
arch=('x86_64')
url="https://github.com/tylorismusic-commits/suite-channel"
license=('GPL-3.0-or-later')
depends=('cairo' 'freetype2' 'libx11' 'lv2')
makedepends=('cmake' 'pkgconf' 'xorg-server-xvfb')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname-$pkgver" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build -j"$(nproc)"
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
